{
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022"],
    "strict": true,
    "preserveConstEnums": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "index.d.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
