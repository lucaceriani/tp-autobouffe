{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tp-autobouffe",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-01",

  "triggers": {
    // at UTC 7:00-8:00 (Zurich UTC +1 (or UTC +2 summer) to include 9:00) from monday to friday
    "crons": ["00 7-8 * * 2-6"]
  },

  "rules": [
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": false },
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": false }
  ],

  // secrets (set with `wrangler secret put`)
  // WEBHOOK_URL = "https://hooks.slack.com/triggers/..."

  "ai": { "binding": "AI" },
  "vars": { "WORKER_ENV": "dev" },

  "env": {
    "prod": {
      // bindings and vars are not inherited by named environments
      "ai": { "binding": "AI" },
      "vars": { "WORKER_ENV": "prod" }
    }
  }
}
